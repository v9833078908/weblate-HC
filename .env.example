# No tokens in this file. The server reads protected secret files.
WIZARD_DATA_DIR=/opt/bdhc/weblate-wizard/shared/data
WIZARD_PUBLIC_ORIGIN=http://192.168.0.180:18511
WIZARD_BIND=0.0.0.0
WIZARD_PORT=18511
WIZARD_SECURE_COOKIE=0
BDHC_API_BASE_URL=http://127.0.0.1:19101
BDHC_API_TOKEN_FILE=/opt/bdhc/weblate-wizard/shared/secrets/bdhc_readonly_token
WEBLATE_API_TOKEN_FILE=/opt/bdhc/weblate-wizard/shared/secrets/weblate_api_token
WEBLATE_MT_ENGINE=openrouter
# Read-only observation after an unconfirmed/async MT request: idle and absolute bounds.
WIZARD_MT_OBSERVATION_SECONDS=1800
WIZARD_MT_MAX_OBSERVATION_SECONDS=7200
# Optional; leave blank to enter translator instructions manually.
PROFILE_LLM_BASE_URL=https://openrouter.ai/api/v1
PROFILE_LLM_TOKEN_FILE=
PROFILE_LLM_MODEL=
