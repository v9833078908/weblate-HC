# Copy to deploy/.env and fill in. This file is read both by docker compose
# (for interpolation) and by the weblate container (env_file).

# --- Site ---------------------------------------------------------------
# Hostname (and optional port) used for absolute URLs in e-mails and
# notifications. Routing does not depend on it, so an extra entry point over a
# bare IP keeps working.
WEBLATE_SITE_DOMAIN=l10n.herocraft.com
WEBLATE_SITE_TITLE=Hero Craft Localization

# Interface language for visitors whose browser asks for something the site
# does not have. A signed-in user keeps whatever they picked in their profile,
# and a browser asking for a supported language still wins over this.
WEBLATE_DEFAULT_LANGUAGE=ru

# Only used when the optional caddy profile is started
# (`docker compose --profile caddy up -d`). On hc-srv15-localizer the host
# nginx already owns port 80, so leave the profile off.
CADDY_SITE_ADDRESS=:80

# Set to 1 only when *every* entry point is HTTPS: it also enables
# SECURE_SSL_REDIRECT, secure cookies and HSTS, which break any plain-HTTP
# access (on hc-srv15-localizer that is the office `http://192.168.0.233/`).
WEBLATE_ENABLE_HTTPS=0
WEBLATE_IP_PROXY_HEADER=HTTP_X_FORWARDED_FOR
WEBLATE_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# Port published on 127.0.0.1 for the host reverse proxy.
# 8000, 8080 and 5432 are already taken on hc-srv15-localizer.
WEBLATE_LOCAL_PORT=8081

# --- Access -------------------------------------------------------------
WEBLATE_ADMIN_NAME=Hero Craft Admin
WEBLATE_ADMIN_EMAIL=loc@herocraft.example
# Used only when the admin account is created on the first start.
WEBLATE_ADMIN_PASSWORD=CHANGE-ME
WEBLATE_REGISTRATION_OPEN=0
WEBLATE_REQUIRE_LOGIN=1

# Private instance: nothing is readable without a login, accounts are created
# by an administrator, and the identity written into the game repositories is
# generated instead of personal - `Hero Craft Localization user <id>` and
# `user-<id>@users.noreply.<site domain>`. Set either to 1 to make the private
# identity a per-user opt-in again, which is the upstream default.
WEBLATE_PRIVATE_COMMIT_EMAIL_OPT_IN=0
WEBLATE_PRIVATE_COMMIT_NAME_OPT_IN=0

# Avatars are fetched from gravatar.com by hashing the user's e-mail, which
# sends that hash off-site on every profile render. Off means local fallback
# images.
WEBLATE_ENABLE_AVATARS=0

# Microsoft Clarity session recordings; empty value disables the integration
WEBLATE_CLARITY_PROJECT_ID=
WEBLATE_DEBUG=0
WEBLATE_LOGLEVEL=INFO

# --- Database -----------------------------------------------------------
POSTGRES_DB=weblate
POSTGRES_USER=weblate
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_HOST=database
POSTGRES_PORT=5432

# --- Cache / queue ------------------------------------------------------
REDIS_HOST=cache
REDIS_PORT=6379
# Judge runs can hold an unacknowledged task for hours. Keep the Redis message
# invisible until the worker completes or dies to avoid duplicate execution.
WEBLATE_CELERY_VISIBILITY_TIMEOUT=14400

# --- Mail ---------------------------------------------------------------
# Outgoing mail goes through Yandex 360 for herocraft.com: implicit SSL on
# port 465 with an app password. The sender address must be the authenticated
# mailbox itself (Yandex rejects any other `From`), so both fields below carry
# the bare address - no display name in the value. The display name in the
# letters comes from WEBLATE_SITE_TITLE at render time; putting it here would
# double-wrap the `From` header and break it.
# Required: Weblate refuses to start with an empty SMTP host.
WEBLATE_EMAIL_HOST=smtp.yandex.ru
WEBLATE_EMAIL_PORT=465
WEBLATE_EMAIL_HOST_USER=webnotify@herocraft.com
WEBLATE_EMAIL_HOST_PASSWORD=CHANGE-ME-APP-PASSWORD
WEBLATE_EMAIL_USE_SSL=1
WEBLATE_EMAIL_USE_TLS=0
# WEBLATE_ADMIN_EMAIL (see Access above) is the error-report recipient;
# it stays a real human mailbox and is unrelated to the sender.
WEBLATE_SERVER_EMAIL=webnotify@herocraft.com
WEBLATE_DEFAULT_FROM_EMAIL=webnotify@herocraft.com

# --- Hero Craft customizations -----------------------------------------
WEBLATE_ADD_MACHINERY=weblate_customization.machinery.RoutedLLMTranslation,weblate_customization.machinery.RoutedLiteLLMTranslation
WEBLATE_ADD_CHECK=weblate_customization.checks.GameMarkupCheck,weblate_customization.checks.GameLineBreakCheck,weblate_customization.checks.CyrillicLeakCheck,weblate_customization.checks.GameNumberCheck,weblate_customization.checks.GameTokenCheck,weblate_customization.checks.GameLengthCheck,weblate_customization.checks.GameMaxLengthCheck,weblate_customization.checks.GameSourceMaxLengthCheck
WEBLATE_REMOVE_CHECK=weblate.checks.chars.MaxLengthCheck,weblate.checks.source.SourceMaxLengthCheck
WEBLATE_ADD_AUTOFIX=weblate_customization.autofixes.LineSeparatorSpacing,weblate_customization.autofixes.RemoveAddedFinalStop,weblate_customization.autofixes.AddFrenchPunctuationSpacing

# Loc-kit glossary profile analysis (separate OpenRouter configuration,
# unrelated to the OpenRouter machinery configured in the web UI). The model
# must support strict structured outputs; OpenRouter is asked to refuse
# providers that cannot honour the JSON schema. Fill the key, then switch
# the feature on.
WEBLATE_LOC_KIT_PROFILE_ANALYSIS_ENABLED=0
WEBLATE_LOC_KIT_PROFILE_OPENROUTER_KEY=
WEBLATE_LOC_KIT_PROFILE_OPENROUTER_MODEL=google/gemini-2.5-flash

# LLM judge (separate LLM configuration, unrelated to both the OpenRouter
# machinery configured in the web UI and the loc-kit profile analysis
# above). Endpoint set by WEBLATE_JUDGE_BASE_URL (default OpenRouter; the
# corporate LiteLLM proxy is also supported). Two seats judge every string
# independently; the same model on both seats is a valid configuration.
# Fill the key and both models, then switch the feature on.
WEBLATE_JUDGE_ENABLED=0
WEBLATE_JUDGE_API_KEY=
WEBLATE_JUDGE_BASE_URL=https://hcbifrost.herocraft.com/litellm/v1
WEBLATE_JUDGE_MODEL_SEAT_1=weblate-judge-deepseek-v4-pro
WEBLATE_JUDGE_MODEL_SEAT_2=atlas/qwen3.8-max
WEBLATE_JUDGE_MAX_REPAIR_ATTEMPTS=1
WEBLATE_JUDGE_BATCH_SIZE=5
WEBLATE_JUDGE_MAX_UNITS_PER_RUN=2000
WEBLATE_JUDGE_REQUEST_SLEEP=0.0
WEBLATE_JUDGE_REQUEST_DEADLINE=120
WEBLATE_JUDGE_REQUEST_IDLE_TIMEOUT=30
WEBLATE_JUDGE_TRANSPORT_RETRIES=1
WEBLATE_JUDGE_PROTOCOL_RETRIES=1
WEBLATE_JUDGE_TRANSIENT_HTTP_RETRIES=1
WEBLATE_JUDGE_MAX_UNPARSED_RETRY_ROUNDS=1
WEBLATE_JUDGE_RETRY_BUDGET_RATIO=0.2
WEBLATE_JUDGE_MAY_APPROVE=0
# Legacy global profile settings. The seat settings below are explicit rather
# than `inherit`, because a paid request contract must not depend on a global
# an operator can retarget: the dev stack's local override sets
# `WEBLATE_JUDGE_REASONING_EFFORT=none`, which `inherit` resolves to and the
# LiteLLM profile resolver then rejects outright.
# Seat 1 uses `json_schema`: `json_object` leaves schema adherence to the
# model. On 2026-08-31 that cost 20 of 26 attempts in two ways - 15
# `invalid-envelope`, where `segments` arrived as an object keyed by index
# instead of an array, and 5 `invalid-segment`, where an error object omitted
# `span`.
# Seat 2 sends no reasoning control at all: the `atlas/qwen3.8-max` model
# group rejects a top-level `enable_thinking` key with HTTP 500.
WEBLATE_JUDGE_REASONING_EFFORT=
WEBLATE_JUDGE_RESPONSE_FORMAT=json_schema
WEBLATE_JUDGE_STREAM=0
WEBLATE_JUDGE_TEMPERATURE=0
WEBLATE_JUDGE_MAX_TOKENS=0
WEBLATE_JUDGE_REASONING_EFFORT_SEAT_1=thinking.disabled
WEBLATE_JUDGE_RESPONSE_FORMAT_SEAT_1=json_schema
WEBLATE_JUDGE_STREAM_SEAT_1=true
WEBLATE_JUDGE_BATCH_SIZE_SEAT_1=2
WEBLATE_JUDGE_TEMPERATURE_SEAT_1=0
WEBLATE_JUDGE_MAX_TOKENS_SEAT_1=0
WEBLATE_JUDGE_REASONING_EFFORT_SEAT_2=
WEBLATE_JUDGE_RESPONSE_FORMAT_SEAT_2=json_schema
WEBLATE_JUDGE_STREAM_SEAT_2=true
# Measured 2026-08-31 over 25 single-string requests to `atlas/qwen3.8-max`:
# median 21s, maximum 103s against a 120s request deadline. A cut batch costs
# every verdict in it, and at batch 5 every batch was cut. Raise this only
# with a fresh latency measurement for the seat's own model.
WEBLATE_JUDGE_BATCH_SIZE_SEAT_2=1
WEBLATE_JUDGE_TEMPERATURE_SEAT_2=0
WEBLATE_JUDGE_MAX_TOKENS_SEAT_2=0
# Keep automatic deferred draining disabled until the production canary.
WEBLATE_JUDGE_DEFERRAL_ENABLED=0
WEBLATE_JUDGE_DEFERRAL_MIN_INTERVAL=900
WEBLATE_JUDGE_DEFERRAL_MAX_INTERVAL=86400
WEBLATE_JUDGE_DEFERRAL_SLOW_AFTER=5
WEBLATE_JUDGE_DEFERRAL_MAX_UNITS_PER_PASS=200
WEBLATE_JUDGE_DEFERRAL_CIRCUIT_FAILURE_THRESHOLD=5
WEBLATE_JUDGE_DEFERRAL_CIRCUIT_OPEN_SECONDS=900
WEBLATE_JUDGE_DEFERRAL_TOKEN_BUCKET_CAPACITY=200
WEBLATE_JUDGE_DEFERRAL_TOKEN_BUCKET_REFILL_PER_SECOND=0.25
WEBLATE_JUDGE_DEFERRAL_OPERATOR_STOPPED=0
# High-volume request diagnostics have bounded retention; verdicts persist.
WEBLATE_JUDGE_REQUEST_ATTEMPT_RETENTION_DAYS=90
WEBLATE_LLM_USAGE_LOG_RETENTION_DAYS=90

# --- VCS ----------------------------------------------------------------
# `http` is needed for the office SCM-Manager, which serves Git over plain
# HTTP only (http://192.168.0.3:8080/scm/git/<repo>).
WEBLATE_VCS_ALLOW_SCHEMES=https,ssh,git,http

# Hosts Weblate may clone from. Weblate refuses private or non-public targets
# unless the host is listed here, so the office SCM-Manager needs an entry.
# The list is exclusive: once it is non-empty, every other repository host has
# to be added as well. Internal `local:` and `weblate://` URLs are unaffected.
WEBLATE_VCS_ALLOW_HOSTS=192.168.0.3

# --- Sizing -------------------------------------------------------------
# hc-srv15-localizer has 4 vCPU and 7.7 GB RAM shared with the cathedral
# stack, so cap the workers instead of auto-scaling.
WEBLATE_WORKERS=2
WEB_WORKERS=2
# Automatic translation runs on the "translate" queue. A judge run occupies a
# slot for tens of minutes, so a single slot lets one project block all others.
CELERY_TRANSLATE_OPTIONS=--concurrency 2 --prefetch-multiplier 1
