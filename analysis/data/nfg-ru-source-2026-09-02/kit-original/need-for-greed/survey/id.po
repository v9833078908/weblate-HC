#: 294040899584
msgid "survey1Intro"
msgstr ""
"Hei! Kuda ingin meluruskan sesuatu.\n"
"\n"
"Hanya beberapa pertanyaan singkat untuk mencari tahu dengan siapa dia "
"berurusan.\n"
"Tidak akan memakan waktu lebih dari satu menit."

#: 384566562816
msgid "survey1Final"
msgstr ""
"Sepertinya… kamu lulus ujian!\n"
"\n"
"Dia mengingat jawabanmu.\n"
"Dan tampaknya memutuskan untuk tidak meninggalkanmu."

#: 5159299321856
msgid "survey1AcceptDescription"
msgstr "Kamu akan mendapatkan hadiah."

#: 5354862940160
msgid "survey1DeclineDescription"
msgstr ""
"Dia akan bertahan…\n"
"mungkin."

