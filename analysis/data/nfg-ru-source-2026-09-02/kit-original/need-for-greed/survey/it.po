msgstr "Nuovi oggetti"

#: 18275869396992
msgid "survey1Question4Answer4"
msgstr "Nuove posizioni"

#: 18730255126528
msgid "survey1Question4Answer5"
msgstr "Obiettivi e ricompense"

#: 19109206298624
msgid "survey1Question5"
msgstr "Cosa dovrebbe essere risolto per primo?"

