msgstr "Segreto"

#: 16583924912128
msgid "survey1Question3"
msgstr "Perché sei qui?"

#: 16952520347648
msgid "survey1Question3Answer1"
msgstr "Correre in giro e fare bottino"

#: 17065502314496
msgid "survey1Question3Answer2"
msgstr "Crea e vendi"

#: 17147127664640
msgid "survey1Question3Answer3"
msgstr "Aggiornamenti e progressione"

#: 17285803937792
msgid "survey1Question3Answer4"
msgstr "Solo vibrazioni…"

#: 17383480889344
msgid "survey1Question4"
msgstr "Cosa manca per non farti andare via?"

#: 17980544258048
msgid "survey1Question4Answer1"
msgstr "Più storia"

#: 18049771245568
msgid "survey1Question4Answer2"
msgstr "Nuovi pericoli, rocce e tesori"

#: 18206881484800
