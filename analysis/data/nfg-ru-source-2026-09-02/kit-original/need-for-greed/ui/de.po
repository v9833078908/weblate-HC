msgstr "Lagerung Stufe {value}"

#: 232285845522223104
msgid "storageUpgradeDescription"
msgstr ""
"Jedes Upgrade gewährt <color=#E01114>mehr Platz</color> für gefundene und "
"geschmiedete Schätze. Mehr Gold, weniger Leid!"

#: 238220511437656064
msgid "revivalDescription"
msgstr "Wiederbeleben — oder verabschiede dich von deiner Beute."

#: 238225411982757888
msgid "noBirdEnergyDescription"
msgstr "Hat dich zum Schatz gebracht und ist zum Ausruhen weggeflogen."

#: 238226013823438848
msgid "callTheBird"
