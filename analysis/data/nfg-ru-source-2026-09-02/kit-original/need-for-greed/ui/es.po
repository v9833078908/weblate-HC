msgid "upgradeCraftEggSlotsStatDescription"
msgstr ""
"Espacio desbloqueado.\n"
"No creas que Coco solo sirve para huevos. Si necesitas derretir hielo, "
"calentar algo o ayudar con otras tareas, siempre es útil. Y cuando se trata "
"de romper huevos, ni siquiera pregunta."

msgid "upgradeCraftSuperSlotsStatDescription"
msgstr ""
