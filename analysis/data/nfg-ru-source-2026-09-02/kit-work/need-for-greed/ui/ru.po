msgid "upgradeCharacterHealthStatDescription"
msgstr "Больше жизней — меньше шансов стать легендой… посмертно."

msgid "upgradeCharacterSpeedStatDescription"
msgstr "Быстрее ноги — меньше шансов стать ужином для местной фауны!"

msgid "upgradeBirdFlyAmountStatDescription"
msgstr "Добавляет запускать дополнительную канарейку для поиска кладов."

msgid "upgradeToolSpeedStatDescription"
msgstr "Чем быстрее удар, тем ближе умопомрачительное богатство!"

msgid "upgradeToolDamageStatDescription"
